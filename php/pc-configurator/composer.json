{
  "name": "course/pc-configurator",
  "type": "project",
  "description": "PC Configurator Laravel coursework",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php artisan package:discover --ansi"
    ]
  },
  "require-dev": {
    "phpunit/phpunit": "~11.5.0",
    "mockery/mockery": "~1.6.0"
  }
}
